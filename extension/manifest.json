{
  "manifest_version": 3,
  "name": "Purp — AI Portfolio Tracker",
  "version": "1.2",
  "description": "Track your crypto & stock portfolio with Gemini AI insights.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://purp-backend.railway.app/*",
    "https://purp-production.up.railway.app/*",
    "https://*.railway.app/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Purp — Portfolio"
  },
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  }
}