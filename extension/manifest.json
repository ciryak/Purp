{
  "manifest_version": 3,
  "name": "Purp — AI Portfolio Tracker",
  "version": "1.2",
  "description": "Track your crypto & stock portfolio with Gemini AI insights.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://purp-backend.railway.app/*",
    "https://purp-production.up.railway.app/*",
    "https://*.railway.app/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://*.sentry.io/*" 
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Purp — Portfolio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.sentry.io https://purp-production.up.railway.app"
  }
}