# CORS: origens permitidas (separadas por vírgula).
# Por defeito já estão incluídos: localhost:3000, 127.0.0.1:3000, localhost:8000, 127.0.0.1:8000,
# e em produção: https://getpurpai.com, https://www.getpurpai.com.
# Para adicionar mais origens (ex.: outro domínio do frontend):
# ALLOWED_ORIGINS=https://getpurpai.com,https://www.getpurpai.com,https://outro-dominio.com

# Security
CRON_SECRET=generate_a_random_secret_here

# Frontend URL for password reset links (e.g. https://getpurpai.com).
# When set, GET /, /reset-password, /home and /home/* are redirected to this URL (Next.js app).
# Leave empty to serve the legacy static HTML from Backend/static/.
FRONTEND_URL=

# Observability
SENTRY_DSN=
ENVIRONMENT=production
