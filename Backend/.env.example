# CORS: origins permitidas (separadas por vírgula). localhost:3000 e 127.0.0.1:3000 são sempre permitidos.
# Em produção, inclua o domínio do frontend (ex.: https://getpurpai.com).
# ALLOWED_ORIGINS=https://getpurpai.com,https://www.getpurpai.com

# Security
CRON_SECRET=generate_a_random_secret_here

# Frontend URL for password reset links (e.g. https://getpurpai.com).
# When set, GET /, /reset-password, /home and /home/* are redirected to this URL (Next.js app).
# Leave empty to serve the legacy static HTML from Backend/static/.
FRONTEND_URL=

# Observability
SENTRY_DSN=
ENVIRONMENT=production
